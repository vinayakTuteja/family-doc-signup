# Copy to .env for local development. In production, set these as secrets on your host
# (for Fly.io: fly secrets set NAME=value). Never commit a real .env file.

APP_NAME=OpenPanel
BASE_URL=http://localhost:8000
DATABASE_PATH=data/signup.db

# Shown in every email and on every page (CASL sender identification).
ORG_LEGAL_NAME=Your legal or business name
ORG_MAILING_ADDRESS=Your mailing address, Toronto, ON
ORG_CONTACT_EMAIL=privacy@yourdomain.ca

# console = save emails to OUTBOX_DIR instead of sending (development).
# smtp = send through your email provider.
EMAIL_BACKEND=console
OUTBOX_DIR=data/outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OpenPanel <hello@yourdomain.ca>
SMTP_STARTTLS=true

# Admin dashboard at /admin. Leave the password empty to switch the dashboard off.
ADMIN_USER=admin
ADMIN_PASSWORD=

MIN_CELL_SIZE=5
RATE_LIMIT_PER_10MIN=5
RUN_RETENTION_IN_APP=true
CONSENT_VERSION=2026-11-v1
